{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.agentparadise.dev/experimental/v1/workspace/credential-ref.schema.json",
  "title": "APSS Credential Reference",
  "description": "Names a credential the provider resolves from implementation-owned configuration. Never carries a value.",
  "$ref": "#/$defs/credentialRef",
  "required": [
    "schema"
  ],
  "$defs": {
    "credentialRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope"
      ],
      "properties": {
        "schema": {
          "const": "apss.credential-ref/v1"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "credentialBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "delivery",
        "target"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/credentialRef"
        },
        "delivery": {
          "enum": [
            "env",
            "file"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
